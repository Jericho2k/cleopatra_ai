SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TOGETHER_API_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
OPENAI_API_KEY=
# Deployment mode. REQUIRED in every environment (SEC-004).
# Recognised values: development | test | production (aliases: dev, local, prod).
# An unset, empty, or unrecognised value resolves to production and fails CLOSED:
# dashboard auth, tenancy checks, and webhook signature verification all stay on,
# and the /test/* helper routes return 404. Local development must set
# APP_ENV=development explicitly — it is no longer the default.
APP_ENV=production

# --- API Fansly integration ---
# Remote API Fansly integration.
# true  = normal live integration
# false = intentionally offline; no remote Fansly HTTP traffic
# Unset means true, so existing deployments keep their current behaviour.
# When false: background chat reconciliation, vault auto-sync and Fansly list
# sync are skipped silently; live sends and forced remote fetches answer 503
# with reason "apifansly_disabled"; passive dashboard refresh no-ops; Full Auto
# reports itself unavailable for real fans. Assisted AI, all stored data and the
# owner-only simulator are unaffected.
APIFANSLY_ENABLED=true

# --- Local Full Auto simulation ---
# Runs the REAL Full Auto pipeline against test_ fans with delivery and
# human-like waiting simulated. The master switch for BOTH tiers below: off
# means nobody simulates, platform owner included. There is no development
# bypass.
AUTO_SIMULATION_ENABLED=false
# AGENCY TIER — may an ordinary dashboard operator open the Simulator on the
# creators it is already assigned? Unset means true whenever the simulator is
# on: an agency testing its own creators against its own test_ fans is the
# product feature, bounded by the ordinary tenancy model. Set it to false to
# narrow the simulator back to the owner allowlist below WITHOUT switching the
# whole feature off — an escape hatch, not the normal configuration.
AUTO_SIMULATION_AGENCY_ACCESS=true
# OWNER TIER — comma-separated Supabase auth user UUIDs for the platform
# owner. This is not "may simulate" (an agency operator may already do that):
# it is "may reach ACROSS tenants" — the cross-tenant catalog mirror — and it
# is also what unlocks AI-stack diagnostics: provider names, model
# identifiers, fallback chains, stage routing and prompt versions are served
# to these accounts only. Empty = nobody.
AUTO_SIMULATION_ALLOWED_USER_IDS=
#
# A simulated turn is DURABLE and POLLED, not one long browser request. The
# POST records a turn in public.simulation_turns and returns a turn id; the
# pipeline runs behind it; the dashboard polls until the turn is terminal. That
# is why there is no browser-timeout setting here to tune: a browser that times
# out, reloads or closes changes nothing about what the backend does or what it
# reports afterwards. Requires db/simulation_turn_durability_v1.sql.
#
# The turn's own ceiling is derived from the writer recovery ladder (see
# WRITER_TURN_DEADLINE_SECONDS below) plus headroom for the rest of the
# pipeline. There is deliberately no variable for it here: a second number to
# keep in sync with the ladder is a number that would eventually disagree.

# Project API key from the API Fansly dashboard. Every connected creator account
# must belong to the same API Fansly workspace/key.
APIFANSLY_API_KEY=
APIFANSLY_BASE_URL=https://v1.apifansly.com/api/fansly
# Stable encryption key for legacy direct-session storage. Do not rotate it
# casually; existing encrypted sessions would become unreadable.
FANSLY_SESSION_KEY=

# --- API auth (security pack) ---
# Shared secret the dashboard sends as X-API-Key on every backend call.
# Generate: openssl rand -hex 32
DASHBOARD_API_SECRET=
# Shared secret for the internal database webhook's X-Webhook-Secret header.
WEBHOOK_SECRET=
# Signing Secret shown when the API Fansly webhook is created. Keep it separate
# from the internal database webhook secret. API Fansly signs the raw JSON body
# with HMAC-SHA256 and sends the digest in Signature.
APIFANSLY_WEBHOOK_SECRET=
# --- Model routing / Model Lab v1 ---
# Production writer. Change provider/model without editing Python.
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-4-6
# CHAT_BASE_URL=
# CHAT_API_KEY_ENV=ANTHROPIC_API_KEY

# Structured situation analyser.
ANALYZER_PROVIDER=anthropic
ANALYZER_MODEL=claude-haiku-4-5-20251001
# ANALYZER_BASE_URL=
# ANALYZER_API_KEY_ENV=ANTHROPIC_API_KEY

# Required if CHAT_PROVIDER/ANALYZER_PROVIDER uses Anthropic.
ANTHROPIC_API_KEY=
# Vault classification always runs NudeNet locally. Its bundled ONNX model has
# no cloud account, per-image charge, or adult-content refusal layer.
VAULT_NUDENET_MIN_CONFIDENCE=0.35
# Fast self-hosted SigLIP2 endpoint. It supplies controlled scene, wardrobe,
# pose, action, framing, and lighting tags plus the embedding used to group
# media from the same shoot.
# VAULT_SEMANTIC_BASE_URL=https://your-semantic-endpoint.modal.run
VAULT_SEMANTIC_TIMEOUT_SECONDS=180

# API Fansly chat reconciliation. Idle creators only list chats every 30
# minutes; creators with global or fan-level auto mode stay at 10 minutes.
CHAT_RECONCILE_TICK_MINUTES=5
CHAT_RECONCILE_ACTIVE_MINUTES=10
CHAT_RECONCILE_IDLE_MINUTES=30
# How many CREATORS may sync or categorise their vault at once, process-wide.
# Separate from the per-media concurrency below, and multiplied by it: at 2 and
# 12, two creators run up to 12 media each and a third waits. Without this bound
# every creator whose 24-hour interval expired in the same hourly pass started
# at once, inside the process that also serves chat. Waiting is lossless — a
# queued creator is parked on a semaphore, not dropped.
VAULT_SYNC_MAX_CONCURRENCY=2
# Number of media analyzed concurrently WITHIN one creator's run. The Modal app
# can scale to ten small GPU containers; 12 keeps the queue fed without flooding
# it.
VAULT_CATEGORIZATION_CONCURRENCY=12
# Videos use real chronological keyframes. Railpack installs ffmpeg from
# railpack.json; unreadable videos stay queued instead of being represented as
# fully analyzed from one poster image.
VIDEO_FRAME_ANALYSIS_ENABLED=true
# How many frames one clip is sampled at. The count is DURATION-AWARE, not
# fixed: roughly VIDEO_FRAMES_PER_MINUTE frames per minute of runtime, clamped
# between the floor and the ceiling, sampled at the midpoint of equal segments
# so the whole clip is covered and intros/outros are not what gets classified.
#
# The floor. Short clips still get enough moments to show any change at all.
# Also what an unreadable duration falls back to, so a video whose metadata the
# CDN withholds costs the minimum rather than the maximum. Bounded to 2-8.
VIDEO_FRAME_MIN_COUNT=4
# The ceiling, and the reason a 45-minute video is not 45 expensive VLM images.
# Clamped below by the floor and above by a hard code ceiling of 16, so no
# configuration can make one asset unbounded. Bounded to the floor-16.
VIDEO_FRAME_MAX_COUNT=12
# The rate between the two. 1 means a 5-minute clip samples 5 frames and a
# 12-minute clip 12; raising it buys detail on long scenes at a proportional
# VLM cost. Bounded to 0.1-4.0.
VIDEO_FRAMES_PER_MINUTE=1
VIDEO_FRAME_MAX_DIMENSION=960
VIDEO_FRAME_TIMEOUT=35
# Qwen3-VL is a confidence-gated fallback for activity, nudity conflicts, and
# ambiguous core semantics. NudeNet remains authoritative if either endpoint
# is absent or unavailable.
# VAULT_VISION_BASE_URL=https://your-modal-endpoint.modal.run
# VAULT_VISION_SHARED_SECRET=
# For a Modal endpoint protected with proxy authentication:
# VAULT_VISION_MODAL_KEY=
# VAULT_VISION_MODAL_SECRET=
VAULT_VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
# Allows Modal's first model download and long-running result redirects to
# finish. Warm requests are normally much faster.
VAULT_VISION_TIMEOUT_SECONDS=620
# Shoot grouping requires agreement between local Pillow features, controlled
# semantic tags, and the SigLIP2 image embedding.
VAULT_SHOOT_MIN_SIMILARITY=0.94

# --- Billed media transfer during vault classification ---
# API Fansly meters media transfer at 2 credits per megabyte, so pulling an
# original video through it to rescue a classification costs real money: a
# 250 MB clip is ~500 credits. These are the ceilings on that, applied BEFORE a
# byte moves. Both a size limit and a credit limit apply and the TIGHTER one
# wins — two views of one quantity, so an operator who thinks in megabytes and
# one who thinks in credits can each set the one they understand. An unknown
# size is always a refusal, never an optimistic attempt. Setting either value
# in a pair to 0 disables downloads for that tier entirely.
#
# AUTOMATIC — background sync and new-media categorisation, which run over a
# whole vault unattended. Deliberately tight: 25 MB covers photos and short
# clips, where a download genuinely rescues a classification, and excludes the
# long originals where the credits are. 25 MB at 2 credits/MB is 50 credits,
# which is why the two defaults match.
VAULT_MAX_AUTO_MEDIA_DOWNLOAD_MB=25
VAULT_MAX_AUTO_MEDIA_DOWNLOAD_CREDITS=50
# MANUAL — one asset an operator deliberately clicked "re-analyze" on, already
# rate-limited to a few a day. Bounded far more generously, but still bounded:
# clicking cannot authorise an unlimited download.
VAULT_MAX_MANUAL_MEDIA_DOWNLOAD_MB=250
VAULT_MAX_MANUAL_MEDIA_DOWNLOAD_CREDITS=500

# Optional OpenAI-compatible self-hosted endpoint (vLLM, SGLang, etc.).
SELF_HOSTED_BASE_URL=http://localhost:8000/v1
SELF_HOSTED_API_KEY=

# Best-effort Supabase usage logging. It never blocks replies if the table is unavailable.
MODEL_TELEMETRY_ENABLED=true
# Optional alternate catalog path.
# CLEOPATRA_MODEL_CATALOG=config/model_candidates.json

# --- AI Stack Profile (which conversational AI brain answers) ---
#
# An AI Stack Profile is the WHOLE conversational AI configuration, not one
# model: every model-powered stage's provider, model, fallback, prompt version,
# reasoning setting and generation parameters. The authoritative registry is
# ai/stack_profiles.py; nothing may be named here that is not in it.
#
#   cleo_legacy_v1  Frozen snapshot of the stack that shipped before the V2
#                   pass. Kimi K2.6 writes ordinary conversation, Qwen3.7-Plus
#                   writes every commercial and safety-sensitive turn, and the
#                   writer uses the writer_v1 prompt. It still honours the
#                   WRITER_*/ANALYZER_*/EXTRACTOR_* variables below, because a
#                   deployment that has one set is running that model today.
#
#   cleo_v2         Kimi K2.6 writes ordinary conversation AND commercial
#                   expression — the deterministic engine already decides what
#                   may be sold, so a sale need not arrive in a different voice —
#                   with Qwen3.7-Plus on Together as the deterministic fallback.
#                   Writer prompt writer_v2. Its stages are PINNED: the variables
#                   below do not re-point them.
#
# UNSET MEANS cleo_legacy_v1. That is deliberate: a deployment that has not been
# told which brain to run must keep behaving exactly as it did before this code
# shipped. Production sets it explicitly.
#
# Legacy means old prompts and old routing. It does NOT mean old bugs: simulator
# isolation, inventory authority, the commercial engine, session recovery and
# every safety rule are shared and identical under both profiles.
#
# Per-creator and per-test-fan overrides are persisted in the database and are
# set from the dashboard (Settings -> AI Stack ADMIN, and the Simulator). They
# require db/ai_stack_profile_v1.sql; without it this variable is the only
# selector and the backend says so in the log rather than failing.
AI_STACK_PROFILE=cleo_v2

# How long a per-creator or per-test-fan override is cached in process. Short,
# because it sits on the reply path; an operator flipping a creator between
# profiles is a rare event.
# AI_STACK_CACHE_SECONDS=15

# --- Production writer routing (Phase 1 final) ---
# These apply to cleo_legacy_v1 only. cleo_v2 pins its own writer stages so a
# variable set months ago for the old stack cannot silently re-point the new one.
# Ordinary conversation uses Kimi K2.6 through OpenRouter, pinned to one upstream
# provider. Complex commercial and safety-sensitive turns use Qwen3.7-Plus on
# Together, deliberately on a different provider so an OpenRouter incident cannot
# take the commercial writer down with it.
#
# WRITER_COMPLEX_MODEL was deepseek-ai/DeepSeek-V4-Pro. Together rejects that
# handle with a live 400 — "Unable to access non-serverless model ... Please
# create and start a dedicated endpoint" — so the fallback never worked and every
# ordinary turn whose Kimi attempts failed ended with no reply at all. Any
# deployment that still sets WRITER_COMPLEX_MODEL to a DeepSeek-V4-Pro handle
# MUST change it; the code default alone will not take effect.
WRITER_ROUTING_ENABLED=true
WRITER_DEFAULT_PROVIDER=openrouter
WRITER_DEFAULT_MODEL=moonshotai/kimi-k2.6
WRITER_COMPLEX_PROVIDER=together
WRITER_COMPLEX_MODEL=Qwen/Qwen3.7-Plus
WRITER_HIGH_VALUE_THRESHOLD_USD=100

# --- Writer recovery ladder (cleo_v3) ---
# On cleo_v3 Kimi IS the writer, so ANOTHER KIMI HOST comes before another
# model, and Qwen is the emergency fallback rather than a second attempt.
#
#   1  Kimi @ Inceptron                      immediate
#      retryable failure -> wait 5s
#   2  Kimi @ Inceptron
#      retryable failure -> wait 30s
#   3  Kimi @ Inceptron
#      retryable failure -> Inceptron is unhealthy FOR THIS TURN
#   4  Kimi @ another eligible OpenRouter host    immediate
#      retryable failure -> wait 5s
#   5  Kimi @ another eligible OpenRouter host    final bounded Kimi attempt
#      retryable failure -> Kimi cannot be served
#   6  Qwen3.7-Plus on Together
#
# Retryable means 429, a provider 5xx, a timeout, or a transport failure. A
# failure no wait and no other host can repair — a rejected key, an unknown
# model, a 4xx our own request caused — skips the whole ladder and goes
# straight to the fallback rather than spending 35 seconds rediscovering it.
#
# cleo_legacy_v1 and cleo_v2 keep the frozen two-attempts-then-fallback plan,
# get no provider failover at all, and ignore every variable in this block.
# WRITER_KIMI_PINNED_ATTEMPTS=3
# WRITER_KIMI_PINNED_WAIT_SECONDS=5,30
# WRITER_KIMI_ALTERNATE_ATTEMPTS=2
# Waits BEFORE alternate attempts 1..N. The first is 0 on purpose: after
# Inceptron has already burned ~35 seconds, waiting again before asking a
# DIFFERENT host is pure latency — its rate limit has nothing to do with the
# one we just hit.
# WRITER_KIMI_ALTERNATE_WAIT_SECONDS=0,5
#
# The backend-owned ceiling for one writer turn. Unset, it is DERIVED from the
# ladder above plus each target's own client timeout, so changing the schedule
# cannot leave it behind. Set it only to impose a tighter bound; it is honoured
# exactly, so a value below one attempt's timeout does cut attempts short.
# WRITER_TURN_DEADLINE_SECONDS=

# RETIRED. These configured the old "four attempts against one provider on a
# 5/30/60 schedule" plan and have no runtime effect. Remove them from Railway:
# leaving them set configures nothing, which is worse than configuring the
# wrong thing. The backend logs [WRITER CONFIG] once at startup if it finds
# either still present.
#   WRITER_PRIMARY_RETRY_ATTEMPTS      -> WRITER_KIMI_PINNED_ATTEMPTS
#   WRITER_PRIMARY_RETRY_WAIT_SECONDS  -> WRITER_KIMI_PINNED_WAIT_SECONDS

# --- The commercial state machine ---
# Gates services/commercial_orchestrator: the deterministic engine that decides
# what may be offered, at what price, from which approved content, and when
# anything may be delivered. With it OFF the pre-engine heuristics run instead
# and nothing is offered deterministically; PPV delivery is still decided by the
# backend from the planned session either way, never by the writer's copy.
COMMERCIAL_LAYER_ENABLED=true

# Both writer targets carry "reasoning_enabled": false in
# config/model_candidates.json. That is not a tuning preference: Kimi K2.6 reasons
# by default, and with reasoning on it spends the completion budget on hidden
# reasoning and returns message.content = null, which the writer reads as
# unparseable output and which produced silent, total writer failure in
# production. Verify a target before trusting it:
#
#   OPENROUTER_API_KEY=... python scripts/openrouter_smoke.py
#   TOGETHER_API_KEY=...   python scripts/openrouter_smoke.py --route complex

# --- OpenRouter (ordinary writer transport) ---
# Required when WRITER_DEFAULT_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# OpenRouter's OpenAI-compatible endpoint. Override only for a proxy.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# PREFERRED upstream provider. Comma-separated OpenRouter provider names sent as
# provider.only on every NORMAL request. Keeping this to one provider is what
# makes behaviour, pricing and prompt-cache affinity predictable, and it stays
# the whole of what healthy traffic does: a successful turn is one Inceptron
# request, cache-affine, exactly as before.
OPENROUTER_PROVIDERS=Inceptron
# Governs NORMAL traffic only. false means "use only the preferred provider and
# surface the upstream error". Leave it false: silently switching to a random
# OpenRouter provider on the first hiccup would change writing style, cost and
# cache locality with no signal, and would discard the cache-affine retries a
# passing rate limit actually needs.
OPENROUTER_ALLOW_FALLBACKS=false
#
# Provider failover is the RECOVERY mechanism and is a different thing from the
# line above. After the preferred provider has failed repeatedly within ONE
# turn, that turn may route the same model elsewhere (provider.ignore =
# [preferred], fallbacks allowed). It is per-turn: the next turn starts at
# Inceptron again, so this is not load balancing and does not distribute
# healthy traffic. Set false to restore pinned-then-Qwen exactly.
# OPENROUTER_PROVIDER_FAILOVER=true
# Optional explicit recovery hosts. Empty — the default — lets OpenRouter pick
# any eligible host that is not the preferred one, so nobody has to keep a list
# of twenty Kimi providers current. Set it only to constrain that discovery.
# OPENROUTER_FALLBACK_PROVIDERS=
# provider.data_collection. "deny" routes only to providers that do not collect
# user data; OpenRouter returns an explicit error if the pinned provider does not
# qualify, which surfaces in model health rather than failing silently. Set to
# "allow" only as a deliberate, documented decision.
#
# Applied identically to pinned AND failover requests. Recovery is never a way
# to reach a host this excludes: if "deny" leaves no alternate eligible, the
# alternate attempt fails and the turn goes to the Qwen fallback, which is the
# correct outcome.
OPENROUTER_DATA_COLLECTION=deny
# provider.zdr. Leave false unless you have confirmed on the model's OpenRouter
# provider page that a Zero Data Retention endpoint exists for it. This flag does
# not create a ZDR guarantee; it only asks OpenRouter to require one.
OPENROUTER_ZDR=false

# --- Passive learned fan intelligence (Phase 2 / Sprint 1) ---
# Keep false until db/fan_intelligence_v1.sql has been applied in Supabase.
FAN_INTELLIGENCE_ENABLED=false
EXTRACTOR_PROVIDER=together
EXTRACTOR_MODEL=openai/gpt-oss-120b
EXTRACTOR_MAX_TOKENS=700

# --- Historical conversation memory (HIST-001) ---
#
# See docs/historical_memory_and_credits.md. Everything here is OFF by default;
# applying db/fan_history_backfill_v1.sql alone changes no behaviour.
#
# NOTE ON COST: API Fansly documents `limit min=1 max=10` on the chat-messages
# endpoint, so a 5,000-message fan is 500 provider round trips — roughly 500
# credits for ordinary pages and ~1,500 for media-heavy ones, which exceed the
# 80 KB proportional-billing threshold. That is a property of the upstream API,
# not a setting. Set a budget before enabling the unattended scheduler.
#
# The unattended deep-history worker. Warm resume (the newest few pages for a
# returning fan whose local context is too thin) and the operator's Load history
# button are NOT gated on this — they are explicit and bounded.
HISTORY_BACKFILL_ENABLED=false
# Historical compaction into fan_facts. Also requires FAN_INTELLIGENCE_ENABLED,
# so a deployment that declined fan intelligence cannot acquire it through a
# history import.
HISTORY_EXTRACTION_ENABLED=false
# Below this many local messages, a returning fan gets a warm resume first.
HISTORY_WARM_MIN_LOCAL_MESSAGES=12
# Newest pages a warm resume may fetch. Capped at the provider maximum of 10.
HISTORY_WARM_MAX_PAGES=3
# Pages one deep-history run may fetch before yielding.
HISTORY_DEEP_PAGES_PER_RUN=20
# The cheap bulk reader for archives. Deliberately NOT the conversational writer
# and NOT the live extractor above: $0.15/M in, $0.50/M out (snapshot — reverify
# before a large import).
HISTORY_EXTRACTOR_PROVIDER=together
HISTORY_EXTRACTOR_MODEL=zai-org/GLM-5.3-Flash
HISTORY_EXTRACTOR_MAX_TOKENS=1400

# --- API Fansly credit budget ---
#
# Rolling 24h ESTIMATED-credit ceiling for OPTIONAL deep history backfill only.
# Unset or 0 means no ceiling.
#
# This is not a kill switch. It is never consulted on a live conversation, a
# delivery, or a purchase reconciliation: running out of history budget pauses
# backfill and nothing else. Credit figures are estimates; API Fansly's own
# Usage dashboard is authoritative.
APIFANSLY_HISTORY_CREDIT_BUDGET_24H=

# Deterministic buyer lifecycle (enable after db/fan_lifecycle_v1.sql)
FAN_LIFECYCLE_ENABLED=false
# Defaults are also stored per creator in creator_lifecycle_policies.
LIFECYCLE_VIP_SPEND_CENTS=50000
LIFECYCLE_VIP_PURCHASE_COUNT=5
LIFECYCLE_FIRST_PURCHASE_INTENT_TTL_HOURS=72

# Phase 2: evidence-backed commercial affordability ledger
AFFORDABILITY_ENABLED=false
AFFORDABILITY_CURRENT_SIGNAL_TTL_HOURS=24
AFFORDABILITY_CONSTRAINT_TTL_HOURS=72

# Phase 2: deterministic price learning over affordability evidence
# Enable only after db/price_learning_v1.sql.
#
# THIS IS THE GATE FOR ADAPTIVE PRICING. With it false, every offer is priced
# from the content's approved range alone: the per-fan probe position, the
# evidence-backed step-up and the whole Pricing strategy picker in the dashboard
# do nothing. The dashboard says so plainly rather than presenting a strategy as
# active, but the honest state to be in is either "true and configured" or
# "false and understood".
#
# The values below are DEPLOYMENT DEFAULTS. An agency configures strategy in the
# dashboard, and the backend resolves creator override, then agency policy, then
# these.
PRICE_LEARNING_ENABLED=false
PRICE_LEARNING_MIN_OFFER_CENTS=500
PRICE_LEARNING_MAX_OFFER_CENTS=50000
PRICE_LEARNING_FIRST_PURCHASE_TARGET_CENTS=2500
PRICE_LEARNING_REPEAT_UPLIFT_BPS=1000
PRICE_LEARNING_VIP_UPLIFT_BPS=1500
PRICE_LEARNING_MAX_STEP_UP_BPS=2500
PRICE_LEARNING_RANGE_WIDTH_BPS=2000
PRICE_LEARNING_PRICE_STEP_CENTS=500
PRICE_LEARNING_LOOKBACK_DAYS=365
# Where inside an approved content range a fan with no evidence is probed.
# 2,500 bps on a $15-$80 set is about $31, not a flat global $25.
PRICE_LEARNING_COLD_START_PROBE_BPS=2500
PRICE_LEARNING_EFFORTLESS_PURCHASE_STREAK=2
# The customer-facing price grid. $5 by default, so a customer sees $25, not
# $24.63. Set this smaller only if cent-level pricing is genuinely wanted.
PRICE_LEARNING_CUSTOMER_PRICE_STEP_CENTS=500
# How long scoped pricing settings are cached in process.
# PRICE_LEARNING_POLICY_CACHE_SECONDS=60

# Phase 2: deterministic next-best-action planning.
# Enable only after db/adaptive_planning_v1.sql.
ADAPTIVE_SESSION_PLANNER_ENABLED=false

# Persistent multi-turn conversation progression
CONVERSATION_DIRECTOR_ENABLED=false

# --- Fansly list mirroring ---
# Pulls the Lists an agency already maintains on the creator's Fansly account
# (VIP, Whales, Buyers, ...) into Cleopatra so they can drive Auto Audience and
# re-engagement targeting. Read-only: Cleopatra never creates, renames, or
# deletes a remote list, and never modifies a locally created Cleopatra list.
# Keep false until db/fansly_lists_v1.sql has been applied in Supabase.
FANSLY_LISTS_SYNC_ENABLED=false
# Every full chat sync refreshes the mirror. An incremental reconciliation pass
# refreshes it only once the mirror is older than this, so no extra scheduler and
# no per-page-load fetching is required.
FANSLY_LISTS_SYNC_INTERVAL_HOURS=6
# Endpoint path segments, overridable so an API Fansly documentation change does
# not require a redeploy. Defaults follow the {accountId}/<resource> shape every
# other API Fansly endpoint in services/apifansly.py uses.
# APIFANSLY_LISTS_PATH=lists
# APIFANSLY_LIST_ITEMS_PATH=items

# --- Automatic vault freshness ---
# Eligibility is checked hourly, but API Fansly is called for a creator only
# when their last successful vault sync is at least 24 hours old.
VAULT_AUTOSYNC_CHECK_SECONDS=3600
VAULT_SYNC_INTERVAL_HOURS=24
# Avoid repeatedly calling an inaccessible creator binding every hourly pass.
VAULT_ACCESS_DENIED_RETRY_SECONDS=86400

# Zero-token provider catalog check used for operator health warnings.
MODEL_AVAILABILITY_CHECK_SECONDS=21600

# --- Full Auto throughput and admission control ---
# Three high-value knobs. All have safe defaults; a deploy needs none of them.
#
# How many INDEPENDENT FANS the scheduled-actions worker may process at once.
# Actions for the same fan are always serialised regardless of this value, so
# raising it buys parallel conversations, never parallel sends to one fan.
SCHEDULED_ACTION_CONCURRENCY=8
# How many due actions one claim locks. Sized above the concurrency so the pool
# always has work queued behind its slots. Keep it comfortably below what the
# worker can finish inside the 10-minute stale-reclaim window.
SCHEDULED_ACTION_CLAIM_LIMIT=24
# Global ceiling on simultaneous model calls — writer, analyzer and extractor
# share it. This is an application policy, deliberately NOT the HTTP connection
# pool size. A burst above this queues; it is never dropped or retried harder.
MODEL_MAX_CONCURRENCY=8

# Idle poll interval. A full claim re-polls almost immediately regardless, and
# work enqueued in this process wakes the loop without waiting this out.
SCHEDULED_ACTION_POLL_SECONDS=5

# --- Health thresholds (operator alerting only, never restart triggers) ---
# Oldest due-but-unstarted action age before /health reports "degraded". Well
# above normal human-like composition delays so realistic timing never alerts.
HEALTH_QUEUE_MAX_AGE_SECONDS=900
# Pending scheduled_actions depth before /health reports "degraded".
HEALTH_QUEUE_MAX_DEPTH=500
